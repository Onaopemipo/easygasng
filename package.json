{
  "name": "easygas-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web -- --port 3003",
    "build": "npm run build --workspace apps/web",
    "start": "npm run start --workspace apps/web",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.json",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "owner:create": "node --import tsx scripts/create-owner.ts",
    "db:export": "node --import tsx scripts/export-bootstrap.ts",
    "format": "prettier --write \"apps/web/**/*.{ts,tsx,css,json}\" \"packages/**/*.ts\" \"scripts/*.ts\" \"tests/*.ts\"",
    "setup": "node --import tsx scripts/bootstrap-team.ts",
    "mail:preview": "node --import tsx scripts/local-mail.ts",
    "worker": "node --import tsx scripts/worker.ts",
    "backup": "node --import tsx scripts/backup.ts",
    "tasks:homepage": "node --import tsx scripts/check-homepage-tasks.ts",
    "release:check": "node --import tsx scripts/release-check.ts",
    "healthcheck": "node --import tsx scripts/healthcheck.ts",
    "backup:postgres": "node --import tsx scripts/postgres-backup.ts"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "type": "module",
  "engines": {
    "node": ">=22.21.0"
  }
}
