{
  "name": "@easygas/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "ios:local": "EAS_BUILD_PROFILE=local-demo EXPO_PUBLIC_API_URL=http://127.0.0.1:3003 expo run:ios --configuration Release",
    "android:local": "EAS_BUILD_PROFILE=local-demo EXPO_PUBLIC_API_URL=http://10.0.2.2:3003 expo run:android --variant release"
  },
  "dependencies": {
    "@expo/vector-icons": "15.0.2",
    "expo": "~58.0.22",
    "expo-constants": "58.0.14",
    "expo-crypto": "58.0.7",
    "expo-file-system": "58.0.13",
    "expo-font": "58.0.11",
    "expo-image-picker": "58.0.10",
    "expo-location": "58.0.20",
    "expo-print": "58.0.8",
    "expo-secure-store": "58.0.2",
    "expo-sharing": "58.0.21",
    "expo-task-manager": "~58.0.13",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-maps": "1.29.11",
    "react-native-safe-area-context": "5.10.1",
    "react-native-svg": "15.16.0",
    "tweetnacl": "1.0.3"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
