# Use an HTTPS origin for deployed builds. Physical devices need a reachable server.
EXPO_PUBLIC_API_URL=http://127.0.0.1:3003
# Set true only after verifying ownership of com.easygasng.customer in both stores.
EASYGAS_NATIVE_IDENTIFIERS_CONFIRMED=false

# Use separate Google Maps SDK keys restricted to the app identifiers/signing.
EASYGAS_NATIVE_GOOGLE_MAPS_ENABLED=false
EASYGAS_GOOGLE_MAPS_IOS_KEY=
EASYGAS_GOOGLE_MAPS_ANDROID_KEY=
