{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "submit": {
    "testing": {
      "ios": {
        "ascAppId": "6838122026",
        "appleTeamId": "RDQ9JJZH7F"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      }
    },
    "local-demo": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://127.0.0.1:3003"
      }
    }
  }
}
