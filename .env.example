# A PostgreSQL URL is mandatory in production. Never commit real credentials.
DATABASE_URL=
# Without DATABASE_URL, development uses a local PGlite database in .data/.
EASYGAS_DATA_DIR=
APP_URL=http://127.0.0.1:3003
# Optional; not enabled until configured and verified in the business settings.
# Payments deliberately remain unconnected by user choice.

# Disable in-process maintenance for isolated QA; default enables the timer.
EASYGAS_BACKGROUND_JOBS=true
# Optional dedicated .next-qa build directory; does not isolate database contents.
EASYGAS_PREVIEW=false
# Enable only after production acceptance; local/preview pages stay noindex.
EASYGAS_INDEXABLE=false
# Emergency appearance rollback; false forces light and hides theme controls.
EASYGAS_DARK_MODE=true
# Emergency tracking write stop. Local default: enabled; production default: disabled.
# Production activation requires the separate tracking safety/integrity release gates.
EASYGAS_TRACKING_MUTATIONS_ENABLED=

# EasyRewards: default OFF; example economics are not business approval.
# Independent policy approval and acceptance gates are also required.
EASYGAS_REWARDS_ISSUANCE_ENABLED=false
EASYGAS_REWARDS_REDEMPTION_ENABLED=false

# Reviewed deployment revision; release:check fails without a 40-character Git SHA.
EASYGAS_RELEASE_SHA=
# Production DB TLS: use sslmode=verify-full and a trusted CA (PGSSLROOTCERT if needed).
# A production worker runs separately with EASYGAS_BACKGROUND_JOBS=false.
# Optional probe override for a separate worker container.
EASYGAS_HEALTH_URL=
# Scheduled backups: protected 0400/0600 key file; never store the key with backups.
EASYGAS_BACKUP_KEY_FILE=
# Restore only into a pre-created, empty easygas_restore_* database.
EASYGAS_RESTORE_URL=
EASYGAS_RESTORE_CONFIRM=

# Transactional SMTP stays OFF until verified sender/provider acceptance.
EASYGAS_EMAIL_ENABLED=false
SMTP_HOST=
# Only TLS-on-connect 465 or required STARTTLS 587 are accepted.
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Messaging is disabled until accounts, consent/templates and sandbox acceptance are approved.
EASYGAS_SMS_ENABLED=false
EASYGAS_WHATSAPP_ENABLED=false
EASYGAS_FIELD_OPERATIONS_ENABLED=false
# Generate 32 random bytes as 64 hex characters; never commit the actual key.
EASYGAS_MESSAGE_ENCRYPTION_KEY=
TERMII_BASE_URL=
TERMII_API_KEY=
TERMII_SENDER=
META_GRAPH_VERSION=
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_TEMPLATE_LANGUAGE=en
META_ACTIVATION_TEMPLATE=
META_OTP_TEMPLATE=
META_INVOICE_TEMPLATE=
META_ACCOUNT_UPDATE_TEMPLATE=
META_WINBACK_TEMPLATE=
# Requires approved privacy/retention policy before production proof uploads.
EASYGAS_PROOF_RETENTION_DAYS=

# Paystack sandbox only. No live activation is supported by these settings.
# Set server-side through secret management; never use NEXT_PUBLIC_ for secrets.
EASYGAS_PAYSTACK_ENABLED=false
EASYGAS_PAYSTACK_MODE=test
# Set synthetic only for an explicitly isolated sandbox dataset, never business records.
EASYGAS_PAYMENT_DATA_CLASS=
PAYSTACK_TEST_SECRET_KEY=
PAYSTACK_WEBHOOK_SIGNATURE_MODE=timestamped
# Comma-separated current/rotating whsec_ test signing secrets. Legacy mode must be explicit.
PAYSTACK_TEST_WEBHOOK_SECRETS=

# Bulk LPG mass custody remains disabled until operational and physical safety acceptance.
EASYGAS_BULK_LPG_ENABLED=false
EASYGAS_DOORSTEP_ENABLED=false

# Road routing: OFF until processor/privacy review and independent dispatch.routing policy approval.
# Fixed HTTPS origin of your trusted OSRM-compatible processor; no path, credentials or query.
EASYGAS_ROAD_ROUTING_ENABLED=false
EASYGAS_OSRM_ORIGIN=

# Versioned financial-document presentation only; no payment activation.
# Capture v2 on new issues/quotes when enabled. Existing snapshots keep v1.
EASYGAS_DOCUMENT_TEMPLATE_V2=false

# Presentation only; false restores the legacy indicator. No business switch.
NEXT_PUBLIC_EASYGAS_BRANDED_LOADER=true
# Set in the mobile client's environment before its separately authorised build.
EXPO_PUBLIC_EASYGAS_BRANDED_LOADER=true

# Live rider sharing and embedded web maps stay disabled until release approval.
EASYGAS_CUSTOMER_RIDER_GPS_ENABLED=false
EASYGAS_CUSTOMER_RIDER_GPS_MAX_AGE_SECONDS=90
NEXT_PUBLIC_EASYGAS_GOOGLE_MAPS_ENABLED=false
NEXT_PUBLIC_EASYGAS_GOOGLE_MAPS_BROWSER_KEY=
NEXT_PUBLIC_EASYGAS_GOOGLE_MAPS_MAP_ID=
